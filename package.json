{
  "name": "seriouslycasualbot",
  "version": "2.0.0",
  "description": "Discord bot for the WoW guild Seriously Casual on EU-Silvermoon",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "test": "vitest run --project default",
    "test:watch": "vitest --project default",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:watch": "vitest --project e2e",
    "lint": "eslint src tests eslint.config.js vitest.config.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,js}\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [],
  "author": "Ryan Wong",
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.98",
    "better-sqlite3": "^12.9.0",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  },
  "comments": {
    "overrides": "undici is pinned to 6.24.1 by discord.js/@discordjs/rest (no upstream release bumps it); force the patched 6.27.x — same-major, API-compatible. esbuild is pinned <0.28.1 by tsx; force the patched line. Both clear Dependabot alerts; revisit/remove when the upstreams move past these."
  },
  "overrides": {
    "undici": "^6.27.0",
    "esbuild": "^0.28.1"
  }
}
