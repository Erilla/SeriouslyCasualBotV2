# Test-server environment — becomes ~/seriouslycasualbot-test/.env on the box.
#
# Copy to .env.test-server, fill in the SANDBOX guild values, then scp it to
# the server (see docs/deployment.md → "Test server"). .env.test-server is
# gitignored; never commit real tokens.
#
# Same shape as .env.example, plus two variables Docker Compose reads on the box.

# Discord Bot — MUST be the sandbox/test guild, never the live guild
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
OFFICER_ROLE_ID=

# WoW Audit
WOWAUDIT_API_SECRET=

# WarcraftLogs
WARCRAFTLOGS_CLIENT_ID=
WARCRAFTLOGS_CLIENT_SECRET=
WARCRAFTLOGS_GUILD_ID=486913

# Raider.io
RAIDERIO_GUILD_IDS=1061585%2C43113

# Gemini (signup quip generator — optional, falls back to static quips if unset)
GEMINI_API_KEY=

# Runtime
LOG_LEVEL=INFO
NODE_ENV=production

# --- Docker Compose (test box only) ---------------------------------------
# Resolves the image to ghcr.io/<owner>/seriouslycasualbot:latest.
# MUST be lowercase (GHCR namespaces are lowercase), e.g. "erilla".
GITHUB_REPOSITORY_OWNER=erilla
# Isolates this stack's container + volume so it can't collide with any other
# compose project on the same host (e.g. a future prod stack).
COMPOSE_PROJECT_NAME=scbot-test
