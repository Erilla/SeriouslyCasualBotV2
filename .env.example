# Discord Bot
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here
OFFICER_ROLE_ID=your_officer_role_id_here

# WoW Audit
WOWAUDIT_API_SECRET=your_wowaudit_secret_here

# WarcraftLogs
WARCRAFTLOGS_CLIENT_ID=your_warcraftlogs_client_id_here
WARCRAFTLOGS_CLIENT_SECRET=your_warcraftlogs_client_secret_here
WARCRAFTLOGS_GUILD_ID=486913

# Battle.net / Blizzard API
BLIZZARD_CLIENT_ID=your_blizzard_client_id_here
BLIZZARD_CLIENT_SECRET=your_blizzard_client_secret_here
# Raider.IO profile crawl age (in hours) after which gear data needs verification
WEEKLY_GEAR_STALE_HOURS=48

# Raider.io
RAIDERIO_GUILD_IDS=1061585%2C43113
# Optional: override the guild identities used for the achievements image.
# JSON array of {region, realm, name}; defaults to Silvermoon + Darksorrow.
# RAIDERIO_GUILDS=[{"region":"eu","realm":"silvermoon","name":"seriouslycasual"}]

# SlashWho applicant intel (optional; see docs/services.md and docs/adr/0001).
# Off: the bot's own sweep runs unchanged. On: SLASHWHO_BOT_API_KEY is required.
SLASHWHO_INTEL_ENABLED=false
SLASHWHO_API_URL=https://slashwho.com
SLASHWHO_BOT_API_KEY=
SLASHWHO_POLL_INTERVAL_MS=5000
SLASHWHO_JOB_DEADLINE_MS=600000
# Shares Warcraft Logs credentials with SlashWho, so leave off to avoid double-spending on failure.
SLASHWHO_FALLBACK_SWEEP=false

# Gemini (signup quip generator — optional, falls back to static quips if unset)
GEMINI_API_KEY=

# Optional: additional quip-generator fallbacks, tried in order after Gemini.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Runtime
LOG_LEVEL=INFO
NODE_ENV=development
